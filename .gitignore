# Git ignore for ZestUI Port Documentation
# Previene la subida accidental de binarios propietarios o imagenes pesadas a GitHub

# Binarios propietarios y blobs de firmware
*.img
*.bin
*.lz4
*.tar
*.tar.md5
*.zip
*.so
*.dat
*.dat.br

# Blobs extraídos del stock
07_Extraidos_STOCK_A235M/boot_ramdisk/kernel.img
07_Extraidos_STOCK_A235M/boot_ramdisk/init
07_Extraidos_STOCK_A235M/boot_ramdisk/dpolicy
03_Vector_B_ELF/raw/libkm_compat.so

# Python y temporales
__pycache__/
*.py[cod]
*$py.class
*.swp
*~
.DS_Store
